{
  "name": "ascii-tree-generator-extended",
  "version": "2.0.0",
  "description": "An extended ASCII tree generator plugin for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "version": "node version.mjs && git add src/manifest.json versions.json",
    "tool": "ts-node tools/deployment-manager.ts",
    "release-patch": "node tools/release.mjs patch",
    "release-minor": "node tools/release.mjs minor",
    "release-major": "node tools/release.mjs major",
    "release-patch-manual": "node tools/release-manual.mjs patch",
    "release-minor-manual": "node tools/release-manual.mjs minor",
    "release-major-manual": "node tools/release-manual.mjs major"
  },
  "keywords": [
    "obsidian",
    "plugin"
  ],
  "author": "Baalgarthem",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^18.15.11",
    "builtin-modules": "^5.3.0",
    "esbuild": "^0.17.18",
    "obsidian": "latest",
    "typescript": "^5.0.4",
    "ts-node": "^10.9.1",
    "inquirer": "^9.2.0"
  }
}
